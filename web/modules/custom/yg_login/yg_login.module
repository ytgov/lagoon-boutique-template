<?php

/**
 * @file
 * YG login standards.
 */

use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_menu_local_tasks_alter().
 *
 * Removes the "Log in" tab from the login page. With password reset off and
 * registration for administrators only, it would be the only tab.
 */
function yg_login_menu_local_tasks_alter(array &$data, string $route_name): void {
  if ($route_name === 'user.login') {
    unset($data['tabs'][0]['user.page']);
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for openid_connect_login_form.
 *
 * Labels the Yukon SSO client's button "Log in with MyYukon".
 */
function yg_login_form_openid_connect_login_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  if (isset($form['openid_connect_client_generic_login'])) {
    $form['openid_connect_client_generic_login']['#value'] = t('Log in with MyYukon');
  }
}
